# copy to terraform.tfvars (git-ignored). No credentials belong in this file: AWS access comes from your environment / profile.
aws_region          = "ap-south-1"
project             = "expensetrail"
public_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]
node_instance_types = ["t3.medium"]
node_desired_size   = 2
